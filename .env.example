# ==============================================================================
# CONFIGURACIÓN DEL MODELO GEMINI (Google GenAI)
# ==============================================================================
# Modelo único obligatorio (sin modelos fallback).
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=32768

# Rotación de API Keys: Puedes configurar una o múltiples claves separadas por coma.
# El sistema ejecuta balanceo Round-Robin y Failover automático si alguna clave
# agota su cuota diaria gratuita (429 / RESOURCE_EXHAUSTED).
GEMINI_API_KEY=AIzaSyTuClavePrincipalAqui, AIzaSyTuClaveSecundariaAqui
# También puedes usar claves individuales:
# GEMINI_API_KEY_1=AIzaSyClave1
# GEMINI_API_KEY_2=AIzaSyClave2

# ==============================================================================
# EMBEDDINGS DE HUGGING FACE (Local con ONNX Runtime)
# ==============================================================================
# Modelo denso de 384 dimensiones ejecutado 100% en local (sin fallback)
HUGGINGFACE_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Token de Hugging Face (opcional, acelera descargas iniciales del modelo de HF Hub)
HF_TOKEN=

# ==============================================================================
# BASE DE DATOS GRAFO NEO4J (Contenedor local: neo4j-data-legal)
# ==============================================================================
# Conexión Bolt al contenedor de Neo4j en puerto local 7688
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
NEO4J_VECTOR_DIMENSIONS=384
NEO4J_VECTOR_INDEX=legal_normas_vector_index
NEO4J_FULLTEXT_INDEX=legal_normas_fulltext_index

# ==============================================================================
# OPEN POLICY AGENT (OPA) - Motor Deóntico Simbólico
# ==============================================================================
# Ruta al binario ejecutable de OPA dentro del directorio de la aplicación (./bin/opa)
OPA_BIN_PATH=./bin/opa
# OPA Server URL (opcional si se utiliza en modo CLI local)
OPA_SERVER_URL=

# ==============================================================================
# SERVIDOR WEB ASTRO
# ==============================================================================
PORT=4321
