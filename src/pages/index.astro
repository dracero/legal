---
import Layout from '../layouts/Layout.astro';
import { getAllCatalogOKFNodes } from '../lib/neo4j/client';
import { CONFIGURED_GEMINI_MODEL } from '../lib/gemini/agent';
import { APP_CONFIG } from '../lib/config';
import { getOpaRuntimeLabel } from '../lib/opa/evaluator';

let initialCatalog = { nodes: [], edges: [] };
try {
  initialCatalog = await getAllCatalogOKFNodes();
} catch (e) {
  console.warn('[Index SSR] Neo4j catalog aún inicializando:', e);
}
const opaLabel = await getOpaRuntimeLabel();
---

<Layout title="Sistema Neuro-Simbólico de Análisis Legal y Razonamiento Deóntico | OKF + Neo4j + OPA + SHACL + Gemini 3.6 Flash">
  <!-- Header Institucional -->
  <header class="sticky top-0 z-30 border-b border-slate-800/80 bg-[#0b1120]/90 backdrop-blur-md">
    <div class="mx-auto flex max-w-[1600px] flex-wrap items-center justify-between gap-4 px-6 py-3.5">
      <div class="flex items-center gap-3.5">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-sky-500 to-indigo-600 font-bold text-white shadow-lg shadow-sky-500/20">
          LEX
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-base font-bold tracking-tight text-white sm:text-lg">
              Sistema Neuro-Simbólico de Análisis Legal y Razonamiento Deóntico
            </h1>
            <span class="rounded-full border border-sky-500/40 bg-sky-500/10 px-2.5 py-0.5 text-[11px] font-semibold text-sky-300">
              v2026.11
            </span>
          </div>
          <p class="text-xs text-slate-400">
            Análisis Dinámico de Documentos • Google OKF + Neo4j Vectorial ({APP_CONFIG.huggingface.model}) + OPA Deóntico (Rego v1) + W3C SHACL + Gemini {CONFIGURED_GEMINI_MODEL}
          </p>
        </div>
      </div>

      <!-- Indicadores de Estado de los Motores -->
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="flex items-center gap-1.5 rounded-lg border border-sky-500/30 bg-sky-500/10 px-2.5 py-1 text-sky-300">
          <span class="h-2 w-2 rounded-full bg-sky-400"></span>
          HF Embeddings: <strong>{APP_CONFIG.huggingface.model}</strong> ({APP_CONFIG.huggingface.dimensions}d)
        </span>
        <span class="flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-emerald-300">
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Neo4j (:7688) • <strong id="header-node-count">{initialCatalog.nodes.length}</strong> Nodos OKF
        </span>
        <button
          id="btn-clear-catalog"
          type="button"
          title="Borrar toda la base de datos Neo4j, fichas OKF y dejar la pantalla completamente en blanco"
          class="js-clear-db-btn flex items-center gap-1 rounded-lg border border-rose-500/40 bg-rose-500/15 px-2.5 py-1 text-[11px] font-semibold text-rose-200 transition hover:bg-rose-500/30 cursor-pointer"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          Borrar Base
        </button>
        <span class="flex items-center gap-1.5 rounded-lg border border-amber-500/30 bg-amber-500/10 px-2.5 py-1 text-amber-300">
          <span class="h-2 w-2 rounded-full bg-amber-400"></span>
          {opaLabel}
        </span>
        <span class="flex items-center gap-1.5 rounded-lg border border-purple-500/30 bg-purple-500/10 px-2.5 py-1 text-purple-300">
          <span class="h-2 w-2 rounded-full bg-purple-400"></span>
          W3C SHACL
        </span>
        <button
          id="btn-toggle-pdf-panel"
          type="button"
          class="flex items-center gap-1.5 rounded-lg bg-sky-600 px-3 py-1.5 font-semibold text-white shadow-sm transition hover:bg-sky-500 cursor-pointer"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
          Cargar Documento Normativo (PDF)
        </button>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-[1600px] px-4 py-5 sm:px-6">
    <!-- PANEL DE INGESTA DE DOCUMENTOS NORMATIVOS POR PDF -->
    <section
      id="pdf-upload-section"
      class="mb-6 rounded-2xl border border-sky-500/30 bg-gradient-to-b from-slate-900/95 to-slate-950/95 p-5 shadow-xl shadow-sky-950/20"
    >
      <div class="mb-4 flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3">
        <div>
          <h2 class="flex items-center gap-2 text-base font-bold text-white">
            <span class="flex h-6 w-6 items-center justify-center rounded-md bg-sky-500/20 text-xs text-sky-400">PDF</span>
            Ingesta Dinámica de Normas (Extracción Ontológica y Deóntica + Validación Pre-Ingesta SHACL + Neo4j)
          </h2>
          <p class="text-xs text-slate-400">
            El sistema desglosa el documento en artículos o cláusulas atómicas OKF, extrae la <strong>Ontología</strong> (conceptos, sujetos) y la <strong>Lógica Deóntica</strong> (obligaciones, prohibiciones, permisiones y sanciones) con Gemini 3.6 Flash, valida mediante SHACL e indexa en Neo4j.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-lg border border-slate-700 bg-slate-800/60 px-3 py-1.5 text-xs text-slate-300">
            100% Dinámico: Basado en el Documento Cargado
          </span>
          <button
            id="btn-clear-panel"
            type="button"
            title="Vaciar Neo4j, borrar fichas OKF y dejar toda la interfaz en blanco"
            class="js-clear-db-btn flex items-center gap-1.5 rounded-lg border border-rose-500/50 bg-rose-600/20 px-3 py-1.5 text-xs font-semibold text-rose-200 transition hover:bg-rose-600/35 cursor-pointer"
          >
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            Borrar Base de Datos y Dejar en Blanco
          </button>
        </div>
      </div>

      <form id="pdf-upload-form" class="grid grid-cols-1 gap-4 lg:grid-cols-12">
        <!-- Selector múltiple de archivos PDF -->
        <div class="lg:col-span-4">
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1.5">
            Archivos PDF de Normas o Contratos (uno o varios)
          </label>
          <label
            id="pdf-dropzone"
            for="pdf-file-input"
            class="flex min-h-28 cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-slate-700 bg-slate-900/70 px-4 py-3 text-center transition hover:border-sky-500/60 hover:bg-slate-900"
          >
            <svg class="mb-1.5 h-7 w-7 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span id="pdf-file-label" class="text-xs font-medium text-slate-200">
              Seleccionar o arrastrar uno o varios PDF (.pdf)
            </span>
            <span class="mt-0.5 text-[11px] text-slate-400">Puedes elegir múltiples archivos a la vez o ir sumándolos</span>
            <input id="pdf-file-input" name="file" type="file" accept=".pdf,application/pdf" multiple class="hidden" />
          </label>
          <div id="pdf-selected-list" class="mt-2 hidden flex-wrap gap-1.5"></div>
        </div>

        <!-- Metadatos de la Norma -->
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 lg:col-span-6">
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Título o Denominación de la Norma</label>
            <input
              id="pdf-law-number"
              name="lawNumber"
              type="text"
              placeholder="Automático según nombre del archivo"
              class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white focus:border-sky-500 focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Ámbito / Jurisdicción</label>
            <input
              id="pdf-jurisdiction"
              name="jurisdiction"
              type="text"
              placeholder="Ej: Nacional, Provincial, General"
              value="General"
              class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white focus:border-sky-500 focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Estado de Vigencia (SHACL)</label>
            <select
              id="pdf-status"
              name="status"
              class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white focus:border-sky-500 focus:outline-none"
            >
              <option value="Vigente">Vigente (Admitida en el Grafo)</option>
              <option value="Historica">Derogada / Histórica (Rechazada por SHACL)</option>
            </select>
          </div>
        </div>

        <!-- Botón de acción -->
        <div class="flex flex-col justify-end lg:col-span-2">
          <button
            id="btn-submit-pdf"
            type="submit"
            class="flex h-20 w-full flex-col items-center justify-center rounded-xl bg-gradient-to-r from-sky-600 to-indigo-600 px-4 py-2.5 text-xs font-bold text-white shadow-lg shadow-sky-600/20 transition hover:from-sky-500 hover:to-indigo-500 cursor-pointer"
          >
            <span>Procesar PDF a OKF</span>
            <span class="mt-0.5 text-[10px] font-normal text-sky-100">Extraer Deóntica + Neo4j</span>
          </button>
        </div>
      </form>

      <!-- Resultado de la Ingesta PDF -->
      <div id="pdf-upload-result" class="mt-3 hidden rounded-xl border border-slate-800 bg-slate-950/90 p-3.5 text-xs"></div>
    </section>

    <!-- BANNER DE ESTADO VACÍO -->
    <div id="empty-catalog-banner" class:list={['mb-6 rounded-2xl border border-sky-500/30 bg-sky-950/25 p-5 shadow-lg', initialCatalog.nodes.length > 0 && 'hidden']}>
      <div class="flex items-start gap-4">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sky-500/20 text-sky-400">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-white">Base de Conocimiento Vacía: Carga de Norma Requerida</h3>
          <p class="mt-1 text-xs text-slate-300">
            El sistema opera en modo <strong>estricto</strong>: analiza <strong>únicamente las normas que usted cargue</strong>. Suba un archivo PDF legal desde el panel superior para poblar el subgrafo en Neo4j, extraer su matriz deóntica y habilitar el pipeline de análisis.
          </p>
        </div>
      </div>
    </div>

    <!-- GRILLA PRINCIPAL: IZQUIERDA (CASO + PIPELINE + DICTAMEN) | DERECHA (GRAFO NEO4J + OPA + SHACL) -->
    <div class="grid grid-cols-1 gap-6 xl:grid-cols-12">
      <!-- COLUMNA IZQUIERDA (7 cols): Consulta de Caso, Pipeline de 6 Agentes y Dictamen Extenso -->
      <div class="space-y-6 xl:col-span-7">
        <!-- TARJETA DE ENTRADA DEL CASO -->
        <div class="rounded-2xl border border-slate-800 bg-slate-900/75 p-5 shadow-lg">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-sm font-bold uppercase tracking-wider text-sky-400">
              Planteo del Caso Fáctico / Situación Jurídica a Analizar
            </h2>
          </div>

          <form id="dictamen-form" class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">
                Descripción Fáctica del Caso
              </label>
              <textarea
                id="textarea-caso"
                rows="4"
                required
                placeholder="Describa los hechos fácticos, las partes intervinientes, las conductas desarrolladas, las omisiones alegadas y las cláusulas o defensas invocadas..."
                class="w-full rounded-xl border border-slate-700 bg-slate-950 p-3.5 text-sm text-slate-100 placeholder-slate-500 focus:border-sky-500 focus:outline-none"
              ></textarea>
            </div>

            <div class="flex items-center justify-between gap-4">
              <div id="pipeline-status-badge" class="text-xs text-slate-400">
                Listo para ejecutar el Pipeline Neuro-Simbólico (6 etapas).
              </div>
              <button
                id="btn-generar-dictamen"
                type="submit"
                class="flex items-center gap-2 rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-lg shadow-sky-500/25 transition hover:from-sky-400 hover:to-indigo-500 cursor-pointer"
              >
                <span>Ejecutar Análisis Neuro-Simbólico</span>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </button>
            </div>
          </form>
        </div>

        <!-- TRAZABILIDAD EN VIVO DE LAS 6 ETAPAS DEL PIPELINE -->
        <div class="rounded-2xl border border-slate-800 bg-slate-900/75 p-5 shadow-lg">
          <div class="mb-3 flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-300">
              Orquestación Multi-Agente Neuro-Simbólica (6 Etapas Deterministas)
            </h3>
            <span id="active-model-pill" class="rounded-md bg-slate-800 px-2 py-0.5 font-mono text-[11px] text-sky-300">
              Modelo: {CONFIGURED_GEMINI_MODEL}
            </span>
          </div>

          <div id="pipeline-steps-grid" class="grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
            <div data-step-card="1" class="rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition">
              <div class="flex items-center justify-between text-xs font-bold text-slate-300">
                <span>1. Clasificador de Hechos</span>
                <span class="step-badge rounded bg-slate-800 px-1.5 py-0.5 text-[10px] text-slate-400">Pendiente</span>
              </div>
              <p class="step-detail mt-1 text-[11px] text-slate-400">Extracción Zod: Sujetos, conductas, omisiones y defensas.</p>
            </div>

            <div data-step-card="2" class="rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition">
              <div class="flex items-center justify-between text-xs font-bold text-slate-300">
                <span>2. Motor Deóntico OPA</span>
                <span class="step-badge rounded bg-slate-800 px-1.5 py-0.5 text-[10px] text-slate-400">Pendiente</span>
              </div>
              <p class="step-detail mt-1 text-[11px] text-slate-400">Evalúa Rego v1: Deberes, prohibiciones, nulidades y Kelsen.</p>
            </div>

            <div data-step-card="3" class="rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition">
              <div class="flex items-center justify-between text-xs font-bold text-slate-300">
                <span>3. Recuperador Neo4j</span>
                <span class="step-badge rounded bg-slate-800 px-1.5 py-0.5 text-[10px] text-slate-400">Pendiente</span>
              </div>
              <p class="step-detail mt-1 text-[11px] text-slate-400">Neo4j HF Vector ({APP_CONFIG.huggingface.model}) + BM25 + Expansión Cypher.</p>
            </div>

            <div data-step-card="4" class="rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition">
              <div class="flex items-center justify-between text-xs font-bold text-slate-300">
                <span>4. Validador SHACL</span>
                <span class="step-badge rounded bg-slate-800 px-1.5 py-0.5 text-[10px] text-slate-400">Pendiente</span>
              </div>
              <p class="step-detail mt-1 text-[11px] text-slate-400">Verifica legal:LegalAnalysisShape y ejecuta autorreparación Cypher.</p>
            </div>

            <div data-step-card="5" class="rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition">
              <div class="flex items-center justify-between text-xs font-bold text-slate-300">
                <span>5. Agente Exégeta (I-IV)</span>
                <span class="step-badge rounded bg-slate-800 px-1.5 py-0.5 text-[10px] text-slate-400">Pendiente</span>
              </div>
              <p class="step-detail mt-1 text-[11px] text-slate-400">Redacción iterativa extensa anclada en el texto normativo cargado.</p>
            </div>

            <div data-step-card="6" class="rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition">
              <div class="flex items-center justify-between text-xs font-bold text-slate-300">
                <span>6. Auditor Epistémico</span>
                <span class="step-badge rounded bg-slate-800 px-1.5 py-0.5 text-[10px] text-slate-400">Pendiente</span>
              </div>
              <p class="step-detail mt-1 text-[11px] text-slate-400">Verifica trazabilidad estricta de citas OKF contra subgrafo Neo4j.</p>
            </div>
          </div>
        </div>

        <!-- VISOR DEL DICTAMEN EXTENSO -->
        <div class="rounded-2xl border border-slate-800 bg-slate-900/90 p-6 shadow-xl">
          <div class="mb-4 flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3">
            <div>
              <h2 class="text-base font-bold text-white">
                Dictamen Jurídico y Análisis Deóntico
              </h2>
              <p id="dictamen-subtitle" class="text-xs text-slate-400">
                Generación fundada exclusivamente en el documento normativo cargado y directivas deterministas OPA.
              </p>
            </div>
            <div class="flex items-center gap-2">
              <span id="dictamen-char-counter" class="rounded-lg border border-slate-700 bg-slate-950 px-2.5 py-1 font-mono text-xs text-sky-300">
                0 palabras
              </span>
            </div>
          </div>

          <div id="dictamen-viewer" class="dictamen-prose min-h-[420px] text-sm text-slate-200">
            <div class="flex h-72 flex-col items-center justify-center text-center text-slate-400">
              <p class="text-sm font-medium text-slate-300">
                Presione "Ejecutar Análisis Neuro-Simbólico" para iniciar la subsunción deóntica y la redacción del dictamen.
              </p>
              <p class="mt-1 max-w-md text-xs text-slate-400">
                Cada cita normativa <code>[norma-...]</code> generada es interactiva y permite inspeccionar en vivo el nodo y sus reglas deónticas en el panel derecho.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- COLUMNA DERECHA (5 cols): PANEL LATERAL DE GRAFO NEO4J, REGLAS OPA Y REPORTE SHACL -->
      <div class="space-y-6 xl:col-span-5">
        <div class="sticky top-20 rounded-2xl border border-slate-800 bg-slate-900/85 p-5 shadow-xl">
          <!-- Pestañas del Panel Lateral -->
          <div class="mb-4 flex rounded-xl bg-slate-950 p-1 text-xs font-semibold">
            <button
              type="button"
              data-tab="tab-graph"
              class="side-tab-btn flex-1 rounded-lg bg-sky-600 py-2 text-white transition cursor-pointer"
            >
              Grafo Neo4j OKF (<span id="tab-graph-count">{initialCatalog.nodes.length}</span>)
            </button>
            <button
              type="button"
              data-tab="tab-opa"
              class="side-tab-btn flex-1 rounded-lg py-2 text-slate-400 hover:text-white transition cursor-pointer"
            >
              Fallo Deóntico OPA
            </button>
            <button
              type="button"
              data-tab="tab-shacl"
              class="side-tab-btn flex-1 rounded-lg py-2 text-slate-400 hover:text-white transition cursor-pointer"
            >
              SHACL & Auditoría
            </button>
          </div>

          <!-- TAB 1: GRAFO INTERACTIVO NEO4J + INSPECTOR DE NODOS OKF -->
          <div id="tab-graph" class="side-tab-pane space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-400">
              <span class="font-mono text-[10px] text-slate-400">Click en un nodo para inspeccionar ontología y deóntica</span>
              <button
                type="button"
                title="Borrar nodos del grafo y reiniciar en blanco"
                class="js-clear-db-btn inline-flex items-center gap-1 rounded border border-rose-500/35 bg-rose-500/10 px-2 py-0.5 text-[10px] font-medium text-rose-300 transition hover:bg-rose-500/25 cursor-pointer"
              >
                Limpiar grafo
              </button>
            </div>

            <!-- Lienzo SVG del Subgrafo -->
            <div class="relative overflow-hidden rounded-xl border border-slate-800 bg-[#060911]">
              <svg id="neo4j-graph-svg" viewBox="0 0 600 380" class="h-[340px] w-full select-none"></svg>
            </div>

            <!-- Inspector del Nodo OKF Seleccionado -->
            <div id="okf-node-inspector" class="rounded-xl border border-slate-800 bg-slate-950 p-4 text-xs">
              <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                <span id="inspector-okf-id" class="font-mono font-bold text-sky-400">norma-id</span>
                <span id="inspector-status" class="rounded border border-emerald-500/30 bg-emerald-500/15 px-2 py-0.5 text-[10px] font-semibold text-emerald-300">
                  Vigente
                </span>
              </div>
              <h4 id="inspector-title" class="mt-2 font-bold text-white">
                Seleccione un nodo del grafo o una cita del dictamen para inspeccionar su ontología y reglas deónticas.
              </h4>
              <p id="inspector-meta" class="mt-1 text-[11px] text-slate-400"></p>

              <!-- Sección de Ontología y Lógica Deóntica Extraída -->
              <div id="inspector-deontic-box" class="mt-3 space-y-2 border-t border-slate-800 pt-2">
                <div class="font-semibold text-sky-300">Matriz Deóntica Extraída del Documento:</div>
                <div id="inspector-deontic-rules" class="space-y-1.5 max-h-36 overflow-y-auto"></div>
              </div>

              <div id="inspector-ontology-box" class="mt-3 space-y-1 border-t border-slate-800 pt-2">
                <div class="font-semibold text-emerald-300">Entidades Ontológicas:</div>
                <div id="inspector-ontology-entities" class="flex flex-wrap gap-1"></div>
              </div>

              <div class="mt-3 border-t border-slate-800 pt-2">
                <div class="font-semibold text-slate-300 mb-1">Texto Normativo:</div>
                <div id="inspector-content" class="max-h-40 overflow-y-auto whitespace-pre-wrap rounded-lg bg-slate-900/90 p-3 font-sans text-xs text-slate-200"></div>
              </div>
            </div>
          </div>

          <!-- TAB 2: MOTOR DEÓNTICO OPA (REGO V1) -->
          <div id="tab-opa" class="side-tab-pane hidden space-y-4 text-xs">
            <div id="opa-decision-container" class="space-y-3">
              <div class="rounded-xl border border-slate-800 bg-slate-950 p-4 text-slate-400">
                Ejecute un análisis para visualizar las directivas deónticas (obligaciones, prohibiciones, nulidades y prelación de Kelsen) activadas en OPA a partir del documento cargado.
              </div>
            </div>
          </div>

          <!-- TAB 3: VALIDADOR ONTOLÓGICO SHACL & AUDITORÍA EPISTÉMICA -->
          <div id="tab-shacl" class="side-tab-pane hidden space-y-4 text-xs">
            <div id="shacl-report-container" class="space-y-3">
              <div class="rounded-xl border border-slate-800 bg-slate-950 p-4 text-slate-400">
                Ejecute un análisis para inspeccionar el reporte W3C SHACL (<code>legal:LegalAnalysisShape</code>), las tripletas RDF en Turtle y la auditoría epistémica de citas.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script id="initial-catalog-json" type="application/json" set:html={JSON.stringify(initialCatalog)}></script>

  <script>
    import { marked } from 'marked';

    const initialCatalogEl = document.getElementById('initial-catalog-json');
    const initialCatalog = initialCatalogEl ? JSON.parse(initialCatalogEl.textContent || '{}') : { nodes: [], edges: [] };

    // Estado global en el cliente y snapshots de plantillas en blanco
    let currentGraphNodes = initialCatalog.nodes || [];
    let currentGraphEdges = initialCatalog.edges || [];
    let selectedNodeId = currentGraphNodes[0]?.okf_id || null;

    const INITIAL_DICTAMEN_HTML = document.getElementById('dictamen-viewer')?.innerHTML || '';
    const INITIAL_OPA_HTML = document.getElementById('opa-decision-container')?.innerHTML || '';
    const INITIAL_SHACL_HTML = document.getElementById('shacl-report-container')?.innerHTML || '';
    const INITIAL_STEP_DETAILS = Array.from(document.querySelectorAll('[data-step-card]')).map((card) => ({
      step: card.getAttribute('data-step-card'),
      detail: card.querySelector('.step-detail')?.textContent || '',
    }));

    function resetInspectorToBlank() {
      const idEl = document.getElementById('inspector-okf-id');
      const statusEl = document.getElementById('inspector-status');
      const titleEl = document.getElementById('inspector-title');
      const metaEl = document.getElementById('inspector-meta');
      const contentEl = document.getElementById('inspector-content');
      const rulesBox = document.getElementById('inspector-deontic-rules');
      const entBox = document.getElementById('inspector-ontology-entities');

      if (idEl) idEl.textContent = 'sin-nodo';
      if (statusEl) {
        statusEl.textContent = 'En blanco';
        statusEl.className = 'rounded border border-slate-700 bg-slate-800/80 px-2 py-0.5 text-[10px] font-semibold text-slate-400';
      }
      if (titleEl) {
        titleEl.textContent = 'Base de conocimiento vacía. Cargue un PDF normativo para inspeccionar artículos.';
      }
      if (metaEl) metaEl.textContent = '';
      if (contentEl) contentEl.textContent = '';
      if (rulesBox) rulesBox.innerHTML = '';
      if (entBox) entBox.innerHTML = '';
    }

    // 1. Renderizador del Grafo SVG de Neo4j
    function renderNeo4jGraph(nodes, edges, highlightId = null) {
      const svg = document.getElementById('neo4j-graph-svg');
      if (!svg) return;
      svg.innerHTML = '';

      const countEl = document.getElementById('tab-graph-count');
      if (countEl) countEl.textContent = String((nodes || []).length);

      if (!nodes || nodes.length === 0) {
        const emptyLabel = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        emptyLabel.setAttribute('x', '300');
        emptyLabel.setAttribute('y', '190');
        emptyLabel.setAttribute('text-anchor', 'middle');
        emptyLabel.setAttribute('fill', '#64748b');
        emptyLabel.setAttribute('font-size', '13');
        emptyLabel.textContent = 'Grafo vacío (0 nodos OKF)';
        svg.appendChild(emptyLabel);
        resetInspectorToBlank();
        return;
      }

      const width = 600;
      const height = 380;
      const cx = width / 2;
      const cy = height / 2;

      // Posicionamiento concéntrico
      const positions = new Map();
      nodes.forEach((node, idx) => {
        const isInner = idx < 5;
        const ringCount = isInner ? Math.min(5, nodes.length) : Math.max(1, nodes.length - 5);
        const ringIndex = isInner ? idx : idx - 5;
        const radius = isInner ? 82 : 152;
        const angle = (2 * Math.PI * ringIndex) / ringCount - Math.PI / 2;
        positions.set(node.okf_id, {
          x: cx + radius * Math.cos(angle),
          y: cy + radius * Math.sin(angle),
          node,
        });
      });

      // Flechas
      const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
      defs.innerHTML = `
        <marker id="arrow" viewBox="0 0 10 10" refX="22" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#475569" />
        </marker>
      `;
      svg.appendChild(defs);

      // Aristas
      edges.forEach((edge) => {
        const src = positions.get(edge.source);
        const dst = positions.get(edge.target);
        if (!src || !dst) return;

        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', String(src.x));
        line.setAttribute('y1', String(src.y));
        line.setAttribute('x2', String(dst.x));
        line.setAttribute('y2', String(dst.y));
        line.setAttribute('stroke', highlightId && (edge.source === highlightId || edge.target === highlightId) ? '#38bdf8' : '#334155');
        line.setAttribute('stroke-width', highlightId && (edge.source === highlightId || edge.target === highlightId) ? '2' : '1.2');
        line.setAttribute('marker-end', 'url(#arrow)');
        svg.appendChild(line);
      });

      // Nodos
      positions.forEach(({ x, y, node }) => {
        const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        g.setAttribute('class', 'cursor-pointer transition-transform');
        const isSelected = node.okf_id === (highlightId || selectedNodeId);

        const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        circle.setAttribute('cx', String(x));
        circle.setAttribute('cy', String(y));
        circle.setAttribute('r', isSelected ? '16' : '12');
        circle.setAttribute('fill', '#0f172a');
        circle.setAttribute('stroke', isSelected ? '#38bdf8' : '#6366f1');
        circle.setAttribute('stroke-width', isSelected ? '3.5' : '2');
        g.appendChild(circle);

        const shortLabel = node.article_number ? `Art. ${node.article_number}` : node.okf_id.replace(/^norma-/, '').slice(0, 12);

        const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        text.setAttribute('x', String(x));
        text.setAttribute('y', String(y + 26));
        text.setAttribute('text-anchor', 'middle');
        text.setAttribute('fill', isSelected ? '#ffffff' : '#94a3b8');
        text.setAttribute('font-size', isSelected ? '10.5' : '9.5');
        text.setAttribute('font-weight', isSelected ? '700' : '500');
        text.textContent = shortLabel;
        g.appendChild(text);

        g.addEventListener('click', () => {
          selectedNodeId = node.okf_id;
          inspectOKFNode(node);
          renderNeo4jGraph(currentGraphNodes, currentGraphEdges, node.okf_id);
        });

        svg.appendChild(g);
      });

      if (highlightId) {
        const found = nodes.find((n) => n.okf_id === highlightId);
        if (found) inspectOKFNode(found);
      } else if (nodes[0]) {
        inspectOKFNode(nodes.find((n) => n.okf_id === selectedNodeId) || nodes[0]);
      }
    }

    function inspectOKFNode(node) {
      if (!node) return;
      document.getElementById('inspector-okf-id').textContent = node.okf_id;
      const statusEl = document.getElementById('inspector-status');
      if (statusEl) {
        statusEl.textContent = node.status || 'Vigente';
        statusEl.className = 'rounded border border-emerald-500/30 bg-emerald-500/15 px-2 py-0.5 text-[10px] font-semibold text-emerald-300';
      }
      document.getElementById('inspector-title').textContent = node.title;
      document.getElementById('inspector-meta').textContent =
        `${node.law_number}${node.article_number ? ' • Art. ' + node.article_number : ''} • Estado: ${node.status || 'Vigente'} • Vía: ${node.retrieval_reason || 'Grafo OKF'}`;
      document.getElementById('inspector-content').textContent = node.content;

      // Renderizar reglas deónticas
      const rulesBox = document.getElementById('inspector-deontic-rules');
      if (rulesBox) {
        const rules = node.deontic_rules || [];
        if (rules.length === 0) {
          rulesBox.innerHTML = '<span class="text-[11px] text-slate-500">Sin reglas deónticas explícitas registradas.</span>';
        } else {
          rulesBox.innerHTML = rules
            .map((r) => {
              const badgeClass =
                r.modalidad === 'OBLIGACION'
                  ? 'bg-amber-500/20 text-amber-300 border-amber-500/30'
                  : r.modalidad === 'PROHIBICION'
                  ? 'bg-rose-500/20 text-rose-300 border-rose-500/30'
                  : r.modalidad === 'SANCION_NULIDAD'
                  ? 'bg-purple-500/20 text-purple-300 border-purple-500/30'
                  : 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30';
              return `
                <div class="rounded border border-slate-800 bg-slate-900/60 p-2 text-[11px]">
                  <div class="flex items-center justify-between gap-1">
                    <span class="rounded border px-1.5 py-0.2 font-mono text-[10px] font-bold ${badgeClass}">${r.modalidad}</span>
                    <span class="font-mono text-slate-400 text-[10px]">${r.id}</span>
                  </div>
                  <div class="mt-1 text-slate-200"><strong>${r.sujeto_normado}:</strong> ${r.conducta}</div>
                  <div class="mt-0.5 text-slate-400"><em>Efecto / Sanción:</em> ${r.consecuencia}</div>
                </div>
              `;
            })
            .join('');
        }
      }

      // Renderizar entidades ontológicas
      const entBox = document.getElementById('inspector-ontology-entities');
      if (entBox) {
        const ents = node.ontological_entities || [];
        if (ents.length === 0) {
          entBox.innerHTML = '<span class="text-[11px] text-slate-500">Sin entidades registradas.</span>';
        } else {
          entBox.innerHTML = ents
            .map(
              (e) =>
                `<span class="rounded bg-emerald-500/15 border border-emerald-500/30 px-2 py-0.5 text-[10px] text-emerald-300" title="${e.descripcion}">${e.nombre} (${e.categoria})</span>`
            )
            .join('');
        }
      }
    }

    // Inicializar grafo
    renderNeo4jGraph(currentGraphNodes, currentGraphEdges);

    // 2. Manejo de Pestañas del Panel Lateral
    const tabBtns = document.querySelectorAll('.side-tab-btn');
    const tabPanes = document.querySelectorAll('.side-tab-pane');

    function activateSideTab(tabId) {
      tabBtns.forEach((btn) => {
        const active = btn.getAttribute('data-tab') === tabId;
        btn.className = active
          ? 'side-tab-btn flex-1 rounded-lg bg-sky-600 py-2 text-white transition cursor-pointer'
          : 'side-tab-btn flex-1 rounded-lg py-2 text-slate-400 hover:text-white transition cursor-pointer';
      });
      tabPanes.forEach((pane) => {
        if (pane.id === tabId) {
          pane.classList.remove('hidden');
        } else {
          pane.classList.add('hidden');
        }
      });
    }

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => activateSideTab(btn.getAttribute('data-tab')));
    });

    // 3. Subida e Ingesta de uno o múltiples Documentos PDF (con drag-and-drop y cola acumulada)
    const pdfInput = document.getElementById('pdf-file-input');
    const pdfDropzone = document.getElementById('pdf-dropzone');
    const pdfLabel = document.getElementById('pdf-file-label');
    const pdfSelectedList = document.getElementById('pdf-selected-list');
    const pdfLawInput = document.getElementById('pdf-law-number');
    const pdfForm = document.getElementById('pdf-upload-form');
    const pdfResultBox = document.getElementById('pdf-upload-result');

    let selectedPdfFiles = [];

    function syncSelectedPdfUI() {
      if (!pdfLabel || !pdfSelectedList) return;

      if (selectedPdfFiles.length === 0) {
        pdfLabel.textContent = 'Seleccionar o arrastrar uno o varios PDF (.pdf)';
        pdfSelectedList.innerHTML = '';
        pdfSelectedList.classList.add('hidden');
        pdfSelectedList.classList.remove('flex');
        if (pdfLawInput) {
          pdfLawInput.disabled = false;
          pdfLawInput.placeholder = 'Automático según nombre del archivo';
          pdfLawInput.value = '';
        }
        return;
      }

      if (selectedPdfFiles.length === 1) {
        pdfLabel.textContent = `1 PDF listo: ${selectedPdfFiles[0].name} (haz clic o arrastra para sumar más)`;
        if (pdfLawInput) {
          pdfLawInput.disabled = false;
          pdfLawInput.placeholder = 'Título de la norma';
          pdfLawInput.value = selectedPdfFiles[0].name.replace(/\.pdf$/i, '');
        }
      } else {
        pdfLabel.textContent = `${selectedPdfFiles.length} documentos PDF seleccionados (puedes seguir sumando)`;
        if (pdfLawInput) {
          pdfLawInput.value = '';
          pdfLawInput.placeholder = `Automático por archivo (${selectedPdfFiles.length} PDFs)`;
          pdfLawInput.disabled = true;
        }
      }

      pdfSelectedList.classList.remove('hidden');
      pdfSelectedList.classList.add('flex');
      pdfSelectedList.innerHTML = selectedPdfFiles
        .map(
          (f, idx) => `
          <span class="inline-flex items-center gap-1 rounded-md border border-sky-500/35 bg-sky-500/15 px-2 py-0.5 text-[11px] text-sky-200">
            <span class="max-w-[180px] truncate">${f.name}</span>
            <button type="button" data-remove-pdf="${idx}" class="text-slate-400 hover:text-rose-300 cursor-pointer" title="Quitar archivo">✕</button>
          </span>`
        )
        .join('');

      pdfSelectedList.querySelectorAll('[data-remove-pdf]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = Number(btn.getAttribute('data-remove-pdf'));
          selectedPdfFiles.splice(idx, 1);
          syncSelectedPdfUI();
        });
      });
    }

    function addPdfFiles(fileList) {
      const incoming = Array.from(fileList || []).filter(
        (f) => f && f.size > 0 && (/\.pdf$/i.test(f.name) || f.type === 'application/pdf')
      );
      for (const file of incoming) {
        const duplicate = selectedPdfFiles.some((e) => e.name === file.name && e.size === file.size);
        if (!duplicate) selectedPdfFiles.push(file);
      }
      if (pdfInput) pdfInput.value = '';
      syncSelectedPdfUI();
    }

    pdfInput?.addEventListener('change', () => {
      addPdfFiles(pdfInput.files);
    });

    pdfDropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      pdfDropzone.classList.add('border-sky-400', 'bg-slate-800/80');
    });

    pdfDropzone?.addEventListener('dragleave', () => {
      pdfDropzone.classList.remove('border-sky-400', 'bg-slate-800/80');
    });

    pdfDropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      pdfDropzone.classList.remove('border-sky-400', 'bg-slate-800/80');
      addPdfFiles(e.dataTransfer?.files);
    });

    async function refreshCatalogGraph() {
      const res = await fetch('/api/laws/catalog');
      if (res.ok) {
        const data = await res.json();
        currentGraphNodes = data.nodes || [];
        currentGraphEdges = data.edges || [];
        document.getElementById('header-node-count').textContent = String(currentGraphNodes.length);
        const emptyBanner = document.getElementById('empty-catalog-banner');
        if (emptyBanner) {
          if (currentGraphNodes.length === 0) {
            emptyBanner.classList.remove('hidden');
          } else {
            emptyBanner.classList.add('hidden');
          }
        }
        renderNeo4jGraph(currentGraphNodes, currentGraphEdges, currentGraphNodes[currentGraphNodes.length - 1]?.okf_id);
      }
    }

    function renderBatchIngestionFeedback(results) {
      pdfResultBox.classList.remove('hidden');
      const okCount = results.filter((r) => r.success).length;
      const failCount = results.length - okCount;
      const totalArticles = results.reduce((acc, r) => acc + (r.nodesIngested?.length || 0), 0);

      pdfResultBox.className =
        failCount === 0
          ? 'mt-3 rounded-xl border border-emerald-500/40 bg-emerald-950/30 p-3.5 text-xs text-emerald-200'
          : okCount > 0
          ? 'mt-3 rounded-xl border border-amber-500/40 bg-amber-950/30 p-3.5 text-xs text-amber-200'
          : 'mt-3 rounded-xl border border-rose-500/40 bg-rose-950/30 p-3.5 text-xs text-rose-200';

      const itemsHtml = results
        .map((r) => {
          if (r.success) {
            const ids = (r.nodesIngested || []).map((n) => n.okf_id).join(', ');
            return `
              <div class="mt-2 rounded-lg border border-emerald-500/30 bg-slate-950/60 p-2.5">
                <div class="flex items-center justify-between font-bold text-emerald-300">
                  <span>✓ ${r.fileName}</span>
                  <span>${r.nodesIngested.length} artículos OKF</span>
                </div>
                <p class="mt-0.5 text-[11px] text-slate-300">${r.extractedCharacters} caracteres • <code>sh:conforms = true</code></p>
                <p class="mt-0.5 font-mono text-[10px] text-sky-300 break-all">${ids}</p>
              </div>`;
          }
          const firstViolation =
            r.shaclReports?.[0]?.report?.violations?.[0]?.message ||
            r.error ||
            'El documento no superó las restricciones SHACL.';
          return `
            <div class="mt-2 rounded-lg border border-rose-500/35 bg-slate-950/60 p-2.5">
              <div class="font-bold text-rose-300">✗ ${r.fileName}</div>
              <p class="mt-0.5 text-[11px] text-rose-200">${firstViolation}</p>
            </div>`;
        })
        .join('');

      pdfResultBox.innerHTML = `
        <div class="flex items-center justify-between font-bold">
          <span>Resultado de Ingesta: ${okCount}/${results.length} documentos indexados</span>
          <span>${totalArticles} nodos agregados a Neo4j</span>
        </div>
        ${itemsHtml}
      `;
    }

    pdfForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (selectedPdfFiles.length === 0) {
        pdfResultBox.classList.remove('hidden');
        pdfResultBox.className = 'mt-3 rounded-xl border border-amber-500/40 bg-amber-950/30 p-3.5 text-xs text-amber-200';
        pdfResultBox.innerHTML = `
          <div class="font-bold text-amber-300">Seleccione uno o más archivos PDF</div>
          <p class="mt-1">Seleccione o arrastre uno o varios archivos PDF para extraer sus artículos atómicos, ontología y reglas deónticas en Neo4j.</p>
        `;
        return;
      }

      const btnSubmitPdf = document.getElementById('btn-submit-pdf');
      btnSubmitPdf.disabled = true;
      btnSubmitPdf.classList.add('opacity-60');

      const jurisdiction = document.getElementById('pdf-jurisdiction')?.value || 'General';
      const status = document.getElementById('pdf-status')?.value || 'Vigente';
      const singleCustomLaw = selectedPdfFiles.length === 1 ? (pdfLawInput?.value || '').trim() : '';

      const results = [];

      try {
        for (let i = 0; i < selectedPdfFiles.length; i++) {
          const file = selectedPdfFiles[i];
          const lawNumber = singleCustomLaw || file.name.replace(/\.pdf$/i, '').trim() || 'Documento Normativo';

          pdfResultBox.classList.remove('hidden');
          pdfResultBox.className = 'mt-3 rounded-xl border border-sky-500/40 bg-sky-950/30 p-3.5 text-xs text-sky-200 animate-pulse';
          pdfResultBox.innerHTML = `
            <div class="font-bold text-sky-300">Procesando documento ${i + 1}/${selectedPdfFiles.length}: ${file.name}</div>
            <p class="mt-1">Segmentando artículos atómicos, extrayendo ontología y lógica deóntica con Gemini 3.6 Flash e indexando en Neo4j...</p>
          `;

          const fd = new FormData();
          fd.append('file', file);
          fd.append('lawNumber', lawNumber);
          fd.append('jurisdiction', jurisdiction);
          fd.append('status', status);

          try {
            const res = await fetch('/api/laws/upload', { method: 'POST', body: fd });
            const data = await res.json();
            results.push({ ...data, fileName: data.fileName || file.name });
            if (data.success) {
              await refreshCatalogGraph();
            }
          } catch (fileErr) {
            results.push({
              success: false,
              fileName: file.name,
              error: fileErr.message || 'Error de red o procesamiento',
            });
          }
        }

        renderBatchIngestionFeedback(results);
        if (results.some((r) => r.success)) {
          selectedPdfFiles = [];
          syncSelectedPdfUI();
        }
      } finally {
        btnSubmitPdf.disabled = false;
        btnSubmitPdf.classList.remove('opacity-60');
      }
    });

    document.getElementById('btn-toggle-pdf-panel')?.addEventListener('click', () => {
      document.getElementById('pdf-upload-section')?.scrollIntoView({ behavior: 'smooth' });
    });

    function resetWorkspaceToBlank() {
      currentGraphNodes = [];
      currentGraphEdges = [];
      selectedNodeId = null;
      selectedPdfFiles = [];

      const headerCount = document.getElementById('header-node-count');
      if (headerCount) headerCount.textContent = '0';

      const emptyBanner = document.getElementById('empty-catalog-banner');
      if (emptyBanner) emptyBanner.classList.remove('hidden');

      pdfForm?.reset();
      syncSelectedPdfUI();
      if (pdfResultBox) {
        pdfResultBox.innerHTML = '';
        pdfResultBox.classList.add('hidden');
      }

      const casoTextarea = document.getElementById('textarea-caso');
      if (casoTextarea) casoTextarea.value = '';

      if (statusBadge) statusBadge.textContent = 'Listo para ejecutar el Pipeline Neuro-Simbólico (6 etapas).';
      if (charCounter) charCounter.textContent = '0 palabras';
      if (viewer) viewer.innerHTML = INITIAL_DICTAMEN_HTML;

      INITIAL_STEP_DETAILS.forEach(({ step, detail }) => {
        const card = document.querySelector(`[data-step-card="${step}"]`);
        if (!card) return;
        card.className = 'rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition';
        const badge = card.querySelector('.step-badge');
        if (badge) {
          badge.className = 'step-badge rounded bg-slate-800 px-1.5 py-0.5 text-[10px] text-slate-400';
          badge.textContent = 'Pendiente';
        }
        const detailEl = card.querySelector('.step-detail');
        if (detailEl) detailEl.textContent = detail;
      });

      const opaBox = document.getElementById('opa-decision-container');
      if (opaBox) opaBox.innerHTML = INITIAL_OPA_HTML;

      const shaclBox = document.getElementById('shacl-report-container');
      if (shaclBox) shaclBox.innerHTML = INITIAL_SHACL_HTML;

      activateSideTab('tab-graph');
      renderNeo4jGraph([], [], null);
    }

    // Borrar base de datos y dejar todo en blanco (unificado en todos los botones .js-clear-db-btn)
    async function handleClearDatabase() {
      if (!confirm('¿Desea borrar por completo la base de datos Neo4j, eliminar los documentos cargados y dejar toda la interfaz en blanco?')) {
        return;
      }

      const clearBtns = Array.from(document.querySelectorAll('.js-clear-db-btn'));
      clearBtns.forEach((btn) => {
        btn.disabled = true;
        btn.classList.add('opacity-60');
      });

      try {
        const res = await fetch('/api/laws/catalog', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
        });
        if (!res.ok) {
          throw new Error(`HTTP ${res.status}`);
        }
        resetWorkspaceToBlank();
        if (statusBadge) {
          statusBadge.textContent = '✓ Base de datos borrada y espacio de trabajo en blanco (0 nodos).';
        }
      } catch (err) {
        if (statusBadge) {
          statusBadge.textContent = `Error al borrar la base de datos: ${err.message}`;
        }
      } finally {
        clearBtns.forEach((btn) => {
          btn.disabled = false;
          btn.classList.remove('opacity-60');
        });
      }
    }

    document.querySelectorAll('.js-clear-db-btn').forEach((btn) => {
      btn.addEventListener('click', handleClearDatabase);
    });

    // 4. Formateo de Markdown con `marked` y Citas Interactivas [okf_id]
    function formatDictamenMarkdownToHtml(markdownText) {
      const renderedHtml = String(marked.parse(markdownText || '', { gfm: true, breaks: false }));
      return renderedHtml.replace(/\[(norma-[a-z0-9_-]+)\]/gi, (_, okfId) => {
        return `<button type="button" data-cite-okf="${okfId}" class="cite-okf-pill inline-flex items-center gap-1 rounded-md border border-sky-500/40 bg-sky-500/15 px-1.5 py-0.5 font-mono text-xs font-semibold text-sky-300 hover:bg-sky-500/30 cursor-pointer">🔗 ${okfId}</button>`;
      });
    }

    function bindCitationPills() {
      document.querySelectorAll('.cite-okf-pill').forEach((pill) => {
        pill.addEventListener('click', () => {
          const okfId = pill.getAttribute('data-cite-okf');
          activateSideTab('tab-graph');
          selectedNodeId = okfId;
          renderNeo4jGraph(currentGraphNodes, currentGraphEdges, okfId);
        });
      });
    }

    // 5. Renderizadores de los Paneles OPA y SHACL
    function renderOPADecisionPanel(opa, hechos) {
      const container = document.getElementById('opa-decision-container');
      if (!container || !opa) return;

      const alerts = [
        ...(opa.incumplimientos_obligacion || []),
        ...(opa.violaciones_prohibicion || []),
        ...(opa.clausulas_invalidas || []),
        ...(opa.permisiones_aplicables || []),
      ];

      container.innerHTML = `
        <div class="rounded-xl border border-amber-500/30 bg-amber-950/20 p-3.5">
          <div class="flex items-center justify-between">
            <span class="font-bold text-amber-300">Motor: ${opa.engine}</span>
            <span class="font-mono text-[11px] text-amber-200">${opa.evaluation_time_ms} ms (0 tokens LLM)</span>
          </div>
          <p class="mt-1 text-[11px] text-slate-300">
            Parte Evaluada: <strong>${hechos.parte_evaluada}</strong> (${hechos.rol_o_condicion_juridica}) • Nodos Obligatorios: <strong>${(opa.nodos_okf_obligatorios || []).length}</strong>
          </p>
        </div>

        <div class="space-y-2">
          <h4 class="font-bold uppercase tracking-wider text-slate-300">Reglas Deónticas y Veredictos Deterministas</h4>
          ${
            alerts.length === 0
              ? '<div class="rounded-lg border border-slate-800 bg-slate-950 p-3 text-slate-400">Sin infracciones directas activadas por los hechos.</div>'
              : alerts
                  .map(
                    (a) => `
              <div class="rounded-lg border border-slate-800 bg-slate-950 p-3">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-mono font-bold text-rose-400">${a.codigo}</span>
                  <span class="rounded bg-slate-800 px-1.5 py-0.5 font-mono text-[10px] text-sky-300">${a.fundamento_okf_id}</span>
                </div>
                <div class="mt-1 font-semibold text-white">${a.veredicto_determinista}</div>
                <p class="mt-1 text-[11px] text-slate-400">${a.directiva_redaccion}</p>
              </div>
            `
                  )
                  .join('')
          }
        </div>

        <div class="rounded-xl border border-slate-800 bg-slate-950 p-3">
          <h4 class="font-bold text-sky-300 mb-1.5">Pirámide de Prelación Normativa (Kelsen)</h4>
          <div class="space-y-1.5">
            ${(opa.prelacion_kelsen || [])
              .map(
                (k) => `
              <div class="border-l-2 border-sky-500 pl-2.5 py-0.5">
                <div class="font-semibold text-slate-200">Rango ${k.rango}: ${k.nivel}</div>
                <div class="text-[11px] text-slate-400">${k.aplicacion}</div>
              </div>
            `
              )
              .join('')}
          </div>
        </div>

        <div class="rounded-xl border border-slate-800 bg-slate-950 p-3">
          <h4 class="font-bold text-indigo-300 mb-1.5">Escenarios Contrafácticos Dinámicos</h4>
          <div class="space-y-2">
            ${(opa.escenarios_contrafacticos || [])
              .map(
                (cf) => `
              <div class="rounded bg-slate-900/80 p-2.5">
                <div class="font-semibold text-slate-200">${cf.titulo}</div>
                <div class="mt-0.5 text-[11px] text-slate-400">${cf.hipotesis}</div>
                <div class="mt-1 text-[11px] text-sky-300"><em>Regla:</em> ${cf.regla_aplicable}</div>
              </div>
            `
              )
              .join('')}
          </div>
        </div>
      `;
    }

    function renderSHACLAndAuditPanel(shaclFinal, reparacionEjecutada, auditoria) {
      const container = document.getElementById('shacl-report-container');
      if (!container) return;

      container.innerHTML = `
        <div class="rounded-xl border ${
          shaclFinal?.conforms ? 'border-emerald-500/40 bg-emerald-950/25' : 'border-rose-500/40 bg-rose-950/25'
        } p-3.5">
          <div class="flex items-center justify-between">
            <span class="font-bold ${shaclFinal?.conforms ? 'text-emerald-300' : 'text-rose-300'}">
              W3C SHACL (legal:LegalAnalysisShape): sh:conforms = ${Boolean(shaclFinal?.conforms)}
            </span>
            <span class="rounded bg-slate-900 px-2 py-0.5 font-mono text-[10px] text-purple-300">
              ${reparacionEjecutada ? 'Autorreparado vía Cypher' : 'Conforme Directo'}
            </span>
          </div>
          <p class="mt-1 text-[11px] text-slate-300">
            Valida que el subgrafo conecte los hechos del caso con normas vigentes del documento y cubra los nodos obligatorios de OPA.
          </p>
        </div>

        ${
          auditoria
            ? `
        <div class="rounded-xl border ${
          auditoria.passed ? 'border-sky-500/30 bg-sky-950/20' : 'border-rose-500/40 bg-rose-950/25'
        } p-3.5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="font-bold ${auditoria.passed ? 'text-sky-300' : 'text-rose-300'}">
              Certificado de Auditoría Epistémica Post-Generación (legal:EpistemicAuditShape)
            </span>
            ${
              auditoria.reparacionEpistemicaEjecutada
                ? '<span class="rounded bg-purple-500/20 px-2 py-0.5 font-mono text-[10px] text-purple-200">Auto-reparado en Etapa 6</span>'
                : ''
            }
          </div>
          <p class="mt-1 text-[11px] text-slate-200">${auditoria.auditSummary}</p>
          <div class="mt-2 flex flex-wrap gap-1">
            ${(auditoria.citedOkfIds || [])
              .map(
                (id) =>
                  `<span class="rounded bg-sky-500/20 px-1.5 py-0.5 font-mono text-[10px] text-sky-300">${id}</span>`
              )
              .join('')}
          </div>
          ${
            (auditoria.unverifiedCitations || []).length > 0
              ? `
          <div class="mt-2 border-t border-rose-500/30 pt-2">
            <div class="text-[10px] font-semibold text-rose-300 mb-1">Citas detectadas fuera del subgrafo:</div>
            <div class="flex flex-wrap gap-1">
              ${auditoria.unverifiedCitations
                .map(
                  (badId) =>
                    `<span class="rounded bg-rose-500/25 border border-rose-500/40 px-1.5 py-0.5 font-mono text-[10px] text-rose-200">[${badId}]</span>`
                )
                .join('')}
            </div>
          </div>
          `
              : ''
          }
        </div>
        `
            : ''
        }

        <div class="rounded-xl border border-slate-800 bg-slate-950 p-3">
          <div class="mb-1.5 font-bold text-slate-300">Grafo RDF Validado en Memoria (Turtle Preview)</div>
          <pre class="max-h-48 overflow-x-auto rounded bg-slate-900 p-2.5 font-mono text-[10px] text-purple-200">${
            shaclFinal?.rdfTurtlePreview || ''
          }</pre>
        </div>
      `;
    }

    // 6. Ejecución del Pipeline Neuro-Simbólico
    const dictamenForm = document.getElementById('dictamen-form');
    const viewer = document.getElementById('dictamen-viewer');
    const statusBadge = document.getElementById('pipeline-status-badge');
    const charCounter = document.getElementById('dictamen-char-counter');

    function updateStepCardUI(stepNumber, status, detailText) {
      const card = document.querySelector(`[data-step-card="${stepNumber}"]`);
      if (!card) return;
      const badge = card.querySelector('.step-badge');
      const detail = card.querySelector('.step-detail');

      if (detail && detailText) detail.textContent = detailText;

      if (status === 'running') {
        card.className = 'rounded-xl border border-sky-500 bg-sky-950/30 p-3 transition shadow-md shadow-sky-500/10';
        if (badge) {
          badge.className = 'step-badge rounded bg-sky-500/20 px-1.5 py-0.5 text-[10px] font-bold text-sky-300 animate-pulse';
          badge.textContent = 'En curso...';
        }
      } else if (status === 'completed' || status === 'repaired') {
        card.className = 'rounded-xl border border-emerald-500/40 bg-emerald-950/20 p-3 transition';
        if (badge) {
          badge.className = 'step-badge rounded bg-emerald-500/20 px-1.5 py-0.5 text-[10px] font-bold text-emerald-300';
          badge.textContent = status === 'repaired' ? 'Reparado ✓' : 'Completado ✓';
        }
      } else if (status === 'failed') {
        card.className = 'rounded-xl border border-rose-500/50 bg-rose-950/30 p-3 transition';
        if (badge) {
          badge.className = 'step-badge rounded bg-rose-500/20 px-1.5 py-0.5 text-[10px] font-bold text-rose-300';
          badge.textContent = 'Alerta ✗';
        }
      }
    }

    dictamenForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const casoPlanteado = document.getElementById('textarea-caso').value;
      const btnSubmit = document.getElementById('btn-generar-dictamen');

      if (currentGraphNodes.length === 0) {
        statusBadge.textContent = 'Debe cargar al menos un documento normativo en PDF antes de ejecutar el análisis.';
        viewer.innerHTML = '<div class="rounded-xl border border-amber-500/40 bg-amber-950/30 p-4 text-xs text-amber-200"><strong class="text-amber-300">Base de conocimiento vacía:</strong> Por favor suba un PDF normativo desde el panel superior. El sistema analizará estricta y exclusivamente el documento cargado.</div>';
        document.getElementById('pdf-upload-section')?.scrollIntoView({ behavior: 'smooth' });
        return;
      }

      btnSubmit.disabled = true;
      btnSubmit.classList.add('opacity-60');
      viewer.innerHTML = '';
      let accumulatedSections = [];
      let latestHechos = null;
      let latestOPA = null;
      let latestSHACLFinal = null;
      let latestReparacionSHACL = false;

      // Resetear tarjetas de etapas
      for (let s = 1; s <= 6; s++) {
        const card = document.querySelector(`[data-step-card="${s}"]`);
        if (card) {
          card.className = 'rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition';
          const badge = card.querySelector('.step-badge');
          if (badge) {
            badge.className = 'step-badge rounded bg-slate-800 px-1.5 py-0.5 text-[10px] text-slate-400';
            badge.textContent = 'En espera';
          }
        }
      }

      try {
        const response = await fetch('/api/dictamen/stream', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ casoPlanteado }),
        });

        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';

        while (true) {
          const { value, done } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });

          const lines = buffer.split('\n');
          buffer = lines.pop() || '';

          for (const line of lines) {
            if (!line.trim()) continue;
            const msg = JSON.parse(line);

            if (msg.type === 'step') {
              const ev = msg.data;
              statusBadge.textContent = `${ev.title}: ${ev.detail}`;
              updateStepCardUI(ev.step, ev.status, ev.detail);

              if (ev.step === 1 && ev.status === 'completed' && ev.payload) {
                latestHechos = ev.payload.hechos;
                document.getElementById('active-model-pill').textContent = `Modelo: ${ev.payload.modelUsed}`;
              }

              if (ev.step === 2 && ev.status === 'completed' && ev.payload) {
                latestOPA = ev.payload;
                renderOPADecisionPanel(latestOPA, latestHechos || { parte_evaluada: 'Parte evaluada', rol_o_condicion_juridica: 'Sujeto normado' });
              }

              if (ev.step === 3 && ev.status === 'completed' && ev.payload) {
                currentGraphNodes = ev.payload.nodes || [];
                currentGraphEdges = ev.payload.edges || [];
                renderNeo4jGraph(currentGraphNodes, currentGraphEdges);
              }

              if (ev.step === 4 && (ev.status === 'completed' || ev.status === 'repaired') && ev.payload) {
                currentGraphNodes = ev.payload.nodes || currentGraphNodes;
                latestSHACLFinal = ev.payload.reporteSHACLFinal;
                latestReparacionSHACL = Boolean(ev.payload.reparacionSHACLEjecutada);
                renderNeo4jGraph(currentGraphNodes, currentGraphEdges);
                renderSHACLAndAuditPanel(latestSHACLFinal, latestReparacionSHACL, null);
              }

              if (ev.step === 5 && ev.status === 'completed' && ev.payload?.chapterCompleted) {
                accumulatedSections.push(ev.payload.chapterCompleted.markdown);
                const fullMd = accumulatedSections.join('\n\n---\n\n');
                viewer.innerHTML = formatDictamenMarkdownToHtml(fullMd);
                bindCitationPills();
                const words = fullMd.trim().split(/\s+/).length;
                charCounter.textContent = `${words} palabras (${fullMd.length} chars)`;
              }

              if (ev.step === 6 && (ev.status === 'completed' || ev.status === 'repaired' || ev.status === 'failed') && ev.payload) {
                if (ev.payload.repairedMarkdown) {
                  viewer.innerHTML = formatDictamenMarkdownToHtml(ev.payload.repairedMarkdown);
                  bindCitationPills();
                  const words = ev.payload.repairedMarkdown.trim().split(/\s+/).length;
                  charCounter.textContent = `${words} palabras (${ev.payload.repairedMarkdown.length} chars)`;
                }
                renderSHACLAndAuditPanel(
                  latestSHACLFinal || { conforms: false, rdfTurtlePreview: '' },
                  latestReparacionSHACL,
                  ev.payload
                );
              }
            } else if (msg.type === 'error') {
              statusBadge.textContent = `Aviso: ${msg.data?.message || 'Error en el pipeline'}`;
              viewer.innerHTML = `<div class="rounded-xl border border-rose-500/40 bg-rose-950/40 p-4 text-xs text-rose-200"><strong class="text-rose-300">Aviso del Sistema:</strong><p class="mt-1">${msg.data?.message || 'Error interno'}</p></div>`;
            } else if (msg.type === 'complete') {
              const finalData = msg.data;
              viewer.innerHTML = formatDictamenMarkdownToHtml(finalData.dictamenCompletoMarkdown);
              bindCitationPills();
              const words = finalData.dictamenCompletoMarkdown.trim().split(/\s+/).length;
              charCounter.textContent = `${words} palabras (${finalData.dictamenCompletoMarkdown.length} chars)`;
              renderSHACLAndAuditPanel(
                finalData.reporteSHACLFinal,
                finalData.reparacionSHACLEjecutada,
                {
                  ...finalData.auditoriaEpistemica,
                  reparacionEpistemicaEjecutada: finalData.reparacionEpistemicaEjecutada,
                }
              );
              statusBadge.textContent = finalData.auditoriaEpistemica?.passed
                ? '✓ Dictamen completado y auditado con trazabilidad SHACL + OPA.'
                : `⚠ Dictamen generado con alertas epistémicas: ${finalData.auditoriaEpistemica?.auditSummary || 'revisar citas'}`;
            }
          }
        }
      } catch (err) {
        console.error('Error en stream del dictamen:', err);
        statusBadge.textContent = 'Error al ejecutar el pipeline.';
      } finally {
        btnSubmit.disabled = false;
        btnSubmit.classList.remove('opacity-60');
      }
    });
  </script>
</Layout>
