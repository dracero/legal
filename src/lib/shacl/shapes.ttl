@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix legal: <http://antigravity.ai/ontologia/legal#> .

# 1. Shape Pre-Ingesta para Nodos Atómicos OKF extraídos del Documento PDF
legal:OKFNodeShape
    a sh:NodeShape ;
    sh:targetClass legal:OKFEntry ;
    sh:property [
        sh:path legal:okf_id ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 3 ;
        sh:message "Todo nodo normativo debe poseer un identificador atómico único (legal:okf_id)." ;
    ] ;
    sh:property [
        sh:path legal:title ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 3 ;
        sh:message "Todo nodo normativo debe poseer un título o encabezado descriptivo (legal:title)." ;
    ] ;
    sh:property [
        sh:path legal:status ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:hasValue "Vigente" ;
        sh:message "Pre-ingesta rechazada: solo se admiten disposiciones normativas en estado 'Vigente'." ;
    ] ;
    sh:property [
        sh:path legal:content ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 10 ;
        sh:message "El nodo debe contener el cuerpo textual de la norma o disposición." ;
    ] .

# 2. Shape Pre-Generación para el Esqueleto Argumental del Dictamen Legal
legal:LegalAnalysisShape
    a sh:NodeShape ;
    sh:targetClass legal:DictamenLegal ;
    sh:property [
        sh:path legal:hasNormaVigente ;
        sh:minCount 1 ;
        sh:message "NormaVigente|El subgrafo debe conectar los hechos del caso con al menos una norma vigente extraída del documento cargado." ;
    ] ;
    sh:property [
        sh:path legal:missingRequiredOPANode ;
        sh:maxCount 0 ;
        sh:message "OPARequired|El subgrafo debe contener todos los nodos obligatorios determinados por el motor deóntico OPA." ;
    ] .

# 3. Shape Post-Generación para Auditoría Epistémica de Trazabilidad de Citas
legal:EpistemicAuditShape
    a sh:NodeShape ;
    sh:targetClass legal:AuditoriaDictamen ;
    sh:property [
        sh:path legal:hasVerifiedCitation ;
        sh:minCount 1 ;
        sh:message "El dictamen redactado debe contener citas verificadas a artículos del documento cargado en Neo4j." ;
    ] ;
    sh:property [
        sh:path legal:hasHallucinatedCitation ;
        sh:maxCount 0 ;
        sh:message "Violación Epistémica: Se detectaron citas normativas no pertenecientes al documento cargado." ;
    ] .
